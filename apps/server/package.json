{
  "name": "@health-buddy/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json && (tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --watch-path=dist --enable-source-maps dist/main.js)",
    "start": "sh ../../scripts/deploy/start.sh",
    "migrate": "node --enable-source-maps dist/db/migrate-cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "twin:compute": "node --enable-source-maps dist/twin/compute-cli.js",
    "companion:sim": "node --enable-source-maps dist/companion/voice/simulator-cli.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1143.0",
    "@health-buddy/ai-engine": "workspace:*",
    "@health-buddy/experts": "workspace:*",
    "@health-buddy/plan-library": "workspace:*",
    "@health-buddy/shared": "workspace:*",
    "@health-buddy/skills": "workspace:*",
    "@napi-rs/canvas": "0.1.80",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@node-rs/argon2": "2.2.2",
    "bullmq": "6.3.10",
    "cookie-parser": "1.4.7",
    "docx": "9.11.0",
    "express": "5.2.1",
    "heic-convert": "2.1.0",
    "helmet": "8.1.0",
    "ioredis": "6.0.0",
    "kysely": "0.29.6",
    "multer": "2.4.0",
    "opusscript": "0.1.1",
    "pdf-lib": "1.17.1",
    "pdfkit": "0.17.2",
    "pg": "8.23.1",
    "pptxgenjs": "4.0.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "ws": "8.18.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@health-buddy/seed": "workspace:*",
    "@nestjs/testing": "11.2.7",
    "@swc/core": "1.16.18",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/multer": "2.2.0",
    "@types/node": "22.20.5",
    "@types/pdfkit": "0.17.6",
    "@types/pg": "8.23.1",
    "@types/supertest": "6.0.3",
    "@types/ws": "8.18.1",
    "supertest": "7.3.1",
    "unplugin-swc": "1.6.0",
    "vitest": "3.2.7"
  }
}
