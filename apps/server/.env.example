# 复制为 .env 后填写。真实密钥只放在本机 .env 或 Railway 环境变量里，不要提交。
NODE_ENV=development
PORT=3000
# 数据库所有者连接串，只用于迁移
DATABASE_URL=postgres://postgres:postgres@localhost:5432/hb_dev
# 应用角色 hb_app 的密码，至少 16 位
APP_DATABASE_PASSWORD=
# 工作台构建产物目录（可选，设置后由后端一并提供页面）
WORKBENCH_DIST=../workbench/dist
# 首次部署时创建的平台管理员（可选）
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
# 大模型网关。密钥只放本机 .env 或 Railway 环境变量
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# 默认厂商：openai 或 anthropic
LLM_DEFAULT_PROVIDER=openai
OPENAI_MODEL=gpt-5
ANTHROPIC_MODEL=claude-opus-5-5
LLM_DEFAULT_EFFORT=medium
# 按用途覆盖（JSON），例如 {"expert":{"provider":"anthropic","effort":"high"}}
LLM_ROUTES=

# ---- 报告上传和识别（M2）----
# 报告原件的对象存储（S3 兼容，服务端加密，不公开访问）。
# S3_BUCKET、S3_ACCESS_KEY_ID、S3_SECRET_ACCESS_KEY 三个都填了才启用；
# 没填时服务照常启动，上传和重新识别接口返回 503 not_configured。
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# MinIO 等需要路径风格地址时设为 true
S3_FORCE_PATH_STYLE=false
# 报告识别队列（BullMQ）用的 Redis，如 redis://default:密码@host:6379。没填时识别不启用
REDIS_URL=
